  {
    "blueprint": "api",
    "identifier": "checkout-rest",
    "title": "Checkout REST API",
    "properties": {
      "type": "openapi",
      "lifecycle": "production",
      "definition": "openapi: 3.0.3\ninfo:\n  title: Checkout REST API\n  version: 2.0.0\npaths:\n  /carts/{cartId}/checkout:\n    post:\n      summary: Convert a cart into an order\n      responses:\n        \"201\":\n          description: Order created\n        \"409\":\n          description: Cart already checked out\n",
      "exposure": "public",
      "hosting_model": "public-cloud",
      "external": false,
      "links": [
        { "title": "API portal", "url": "https://api.example.com/docs/checkout" }
      ]
    },
    "relations": { "system": "storefront", "owned_by": "retail-tribe" }
  },
  {
    "blueprint": "api",
    "identifier": "live-cart",
    "title": "Live Cart socket",
    "properties": {
      "type": "web-sockets",
      "lifecycle": "experimental",
      "definition_url": "https://github.com/acme/live-cart-gateway/blob/main/PROTOCOL.md",
