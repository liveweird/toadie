      "hosting_model": "public-cloud"
    },
    "relations": { "system": "storefront", "owned_by": "retail-tribe" }
  },
  {
    "blueprint": "api",
    "identifier": "order-events",
    "title": "Order events stream",
    "properties": {
      "type": "asyncapi",
      "lifecycle": "experimental",
      "definition": "asyncapi: 2.6.0\ninfo:\n  title: Order events\n  version: 0.4.0\nchannels:\n  order.placed:\n    subscribe:\n      message:\n        payload:\n          type: object\n          properties:\n            orderId: { type: string }\n            totalMinor: { type: integer }\n",
      "exposure": "internal",
      "hosting_model": "on-premise"
    },
    "relations": { "system": "storefront", "owned_by": "retail-tribe" }
  },
