{
  "identifier": "environment",
  "title": "Environment",
  "description": "One of Port's default blueprints: a place a workload actually runs — production, staging, or a throwaway test cluster. Check `is_locked` before you touch anything here; a locked environment means someone deliberately froze it.",
  "icon": "Environment",
  "schema": {
    "properties": {
      "type": {
        "type": "string",
        "title": "Type",
        "enum": ["production", "staging", "test"],
        "enumColors": { "production": "darkGray", "staging": "lightGray", "test": "bronze" }
      },
      "region": {
        "type": "string",
        "title": "Region",
        "enum": ["us-east-1", "eu-west-1", "ap-southeast-1"]
      },
      "is_locked": {
        "type": "boolean",
        "title": "Locked",
        "description": "Frozen against further changes.",
        "default": false
      },
      "nightly_shutdown": {
        "type": "boolean",
        "title": "Nightly shutdown",
        "description": "Whether this environment powers down outside working hours."
      },
      "cluster_config": {
        "type": "string",
        "title": "Cluster config",
        "format": "yaml"
      },
      "ingress_ip": {
        "type": "string",
        "title": "Ingress IPv4",
        "format": "ipv4"
      },
      "ingress_ipv6": {
        "type": "string",
        "title": "Ingress IPv6",
        "format": "ipv6"
      },
      "created": {
        "type": "string",
        "title": "Created",
        "format": "date-time",
        "date_format": "24-hour"
      }
    },
    "required": ["type"]
  }
}
