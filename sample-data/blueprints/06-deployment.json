{
  "identifier": "deployment",
  "title": "Deployment",
  "description": "One rollout of a workload — a single row in the deploy history a team scrolls through after an incident. `sibling_deploys` counts every other deployment of the same shape, including itself as a target, so the count never breaks when the workload grows a new deploy.",
  "icon": "GitCommit",
  "schema": {
    "properties": {
      "version": {
        "type": "string",
        "title": "Version",
        "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
      },
      "status": {
        "type": "string",
        "title": "Status",
        "enum": ["pending", "running", "succeeded", "failed"],
        "enumColors": { "pending": "lightGray", "running": "blue", "succeeded": "green", "failed": "red" }
      },
      "duration_seconds": {
        "type": "number",
        "title": "Duration (seconds)",
        "exclusiveMinimum": 0
      },
      "commit": {
        "type": "string",
        "title": "Commit",
        "format": "url"
      },
      "notes": {
        "type": "string",
        "title": "Notes",
        "format": "markdown"
      },
      "deployed_at": {
        "type": "string",
        "title": "Deployed at",
        "format": "date-time",
        "date_format": "YYYY-MM-DD HH:mm"
      }
    },
    "required": ["version"]
  },
  "relations": {
    "workload": {
      "title": "Deploys workload",
      "target": "workload",
      "required": true,
      "many": false
    }
  },
  "calculationProperties": {
    "is_fast": {
      "title": "Is fast",
      "type": "boolean",
      "calculation": ".properties.duration_seconds < 60"
    }
  },
  "aggregationProperties": {
    "sibling_deploys": {
      "title": "Sibling deploys",
      "target": "deployment",
      "calculationSpec": { "calculationBy": "entities", "func": "count" }
    }
  }
}
