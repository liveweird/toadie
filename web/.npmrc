# Dependabot's npm updater reads this file the same way `npm ci`/`npm install` does, so it
# resolves this workspace's peer-dependency conflict (openapi-typescript declares TS ^5 while
# the scaffold uses TS 6 — see web/CLAUDE.md) without a bespoke Dependabot config option.
# This does NOT change CI or local behavior: `npm ci --legacy-peer-deps` (CLAUDE.md, CI, this
# README) is the same setting spelled as a flag instead of a file, so both keep resolving
# identically whether or not the flag is also passed on the command line.
legacy-peer-deps=true
